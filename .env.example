# ==============================================================================
# AURA (Adaptive Unified Reasoning Assistant) - Environment Template
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME=AURA
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_hex_key_minimum_32_chars

# Server Settings
HOST=127.0.0.1
PORT=8000

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aura_user
POSTGRES_PASSWORD=aura_password_placeholder
POSTGRES_DB=aura_db

# Security & Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Model Provider (Local / Open-weight)
MODEL_PROVIDER=ollama
MODEL_BASE_URL=http://localhost:11434
MODEL_NAME=qwen2.5:3b-instruct-q4_K_M

# Storage & Uploads
STORAGE_LOCAL_DIR=./data/storage
MAX_UPLOAD_SIZE_BYTES=10485760
